# 可選 groq 或 gemini。若省略，會優先使用已設定的 Groq Key。
LLM_PROVIDER=gemini

# AMIE-inspired 狀態感知問診。需要回退固定問卷時改成 legacy。
INTERVIEW_ENGINE=amie
# AMIE_MAX_TURNS=24
# 測試期每輪在病患端顯示 AMIE 決策摘要；正式上線前請改為 false。
AMIE_DEBUG_TRACE=true

# 醫師端規則中心的 Safety 規則更新權杖；未設定時規則中心維持唯讀。
# 請使用足夠長的隨機值，且不要提交實際權杖。
# SAFETY_RULE_ADMIN_TOKEN=請替換為隨機管理權杖

# 問診結果 SQLite；相對路徑以 backend/ 為基準。
# CONSULTATION_DB_PATH=data/consultations.db

# HAPI FHIR terminology server；SNOMED CT 查詢頁會由後端代理至此網址。
FHIR_BASE_URL=http://127.0.0.1:8080/fhir
# SNOMED_SEARCH_DB=terminology/snomed/snomed-search.sqlite3

# 使用 Gemini 時設定
GEMINI_API_KEY=你的Gemini_API_Key
# GEMINI_MODEL=gemini-2.5-flash
# Gemini 2.5 Pro 無法關閉 thinking；預設使用官方最小 budget 128。
# GEMINI_THINKING_BUDGET=128

# 使用 Groq 時設定
# GROQ_API_KEY=你的Groq_API_Key
# GROQ_MODEL=llama-3.3-70b-versatile
# GROQ_TRANSCRIPTION_MODEL=whisper-large-v3-turbo

# RAG v2 五個 collections 完成建庫與醫療審查後才開啟；預設為 legacy。
# RAG_INDEX_VERSION=v2

# Gemini 先將去識別化查詢中的醫療術語正規化為英文，以提高英文語料檢索準確率；
# 真正的 embedding、相似度搜尋與 Chroma 資料庫仍在本機執行。
RAG_QUERY_TRANSLATION=gemini
# dual：中文原查詢＋英文查詢合併（建議）；english：只使用英文查詢。
# RAG_QUERY_MODE=dual
# GEMINI_TRANSLATION_MODEL=gemini-2.5-flash
# RAG_TRANSLATION_MAX_INPUT_CHARS=4000
