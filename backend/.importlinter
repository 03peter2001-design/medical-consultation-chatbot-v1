[importlinter]
root_packages =
    amie
    app
    domain
    infrastructure
    knowledge
    medkgi
    scripts

[importlinter:contract:domain-boundary]
name = Domain must remain independent
type = forbidden
source_modules =
    domain
forbidden_modules =
    amie
    app
    infrastructure
    knowledge
    medkgi

[importlinter:contract:infrastructure-boundary]
name = Infrastructure must not depend on application concerns
type = forbidden
source_modules =
    infrastructure
forbidden_modules =
    amie
    app
    domain
    knowledge
    medkgi

[importlinter:contract:knowledge-boundary]
name = Knowledge retrieval must remain independent
type = forbidden
source_modules =
    knowledge
forbidden_modules =
    amie
    app
    domain
    infrastructure
    medkgi

[importlinter:contract:amie-boundary]
name = AMIE workflow may only depend on the domain layer
type = forbidden
source_modules =
    amie
forbidden_modules =
    app
    infrastructure
    knowledge

[importlinter:contract:medkgi-boundary]
name = MedKGI core must remain independent
type = forbidden
source_modules =
    medkgi
forbidden_modules =
    amie
    app
    domain
    infrastructure
    knowledge
