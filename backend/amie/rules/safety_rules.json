  "semantic_extraction": {
    "normalization_instructions": [
      "依整句上下文判斷概念，可處理常見錯字、同音字、中英混用與口語表達。",
      "evidence 必須逐字保留患者原文，不得把修正後的標準詞寫進 evidence。",
      "只有原文明確支持時才能輸出 present；語意不明時保持 unknown。",
      "不要將未指明部位的疼痛，直接推定為胸痛、頭痛或腹痛。",
      "不要把語意不明的 dizzy 或頭暈直接當成 vertigo；未描述旋轉感時使用 dizziness_unspecified。"
    ],
    "severity_definitions": {
      "mild": "患者明確描述症狀輕微，對活動影響很小。",
      "moderate": "患者明確描述症狀介於輕微與難以忍受之間，已造成一定影響。",
      "severe": "患者明確表達症狀非常強烈、難以忍受或接近可承受極限；必須結合症狀部位判斷。",
      "unknown": "原文不足以可靠判斷強度。"
    },
    "finding_definitions": {
      "altered_consciousness": "意識改變、反應異常或無法正常喚醒。",
      "syncope": "短暫失去意識或昏倒。",
      "severe_breathing": "嚴重呼吸困難或無法正常呼吸。",
      "diaphoresis": "明確出現大量冷汗。",
      "tearing_pain": "明確描述撕裂樣疼痛。",
      "vertigo": "明確描述自身或環境旋轉、天旋地轉。",
      "dizziness_unspecified": "只描述 dizzy、頭暈或暈眩，但未說明旋轉、昏厥感或不平衡。",
      "gait_unsteadiness": "走路明顯不穩或無法維持平衡。",
      "nausea": "噁心或想吐但不一定已經嘔吐。",
      "vomiting": "已經發生嘔吐。",
      "blurred_vision": "視線或視力變得模糊。",
      "visual_change_unspecified": "結構化選項表示視覺異常，但未區分模糊、複視或視力喪失。",
      "vision_loss": "部分或全部視力突然喪失。",
      "diplopia": "看見重影或複視。",
      "focal_weakness": "單側或局部肢體無力。",
      "focal_neurologic_symptom": "結構化選項表示單側無力或麻木等局部神經症狀。",
      "facial_droop": "臉部單側下垂或嘴角歪斜。",
      "speech_difficulty": "說話含糊、無法表達或理解語言。",
      "fever": "患者明確表示發燒。",
      "neck_stiffness": "頸部僵硬或難以前彎。",
      "major_bleeding": "明確描述大量或持續性出血。",
      "recent_head_trauma": "近期頭部撞擊或外傷。",
      "vaginal_bleeding": "非預期的陰道出血。"
    }
  },
