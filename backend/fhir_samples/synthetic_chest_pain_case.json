        "subject": {
          "reference": "urn:uuid:00000000-0000-4000-8000-000000000001"
        },
        "encounter": {
          "reference": "urn:uuid:00000000-0000-4000-8000-000000000002"
        },
        "authored": "2026-07-27T13:55:00+08:00",
        "author": {
          "reference": "urn:uuid:00000000-0000-4000-8000-000000000001"
        },
        "source": {
          "reference": "urn:uuid:00000000-0000-4000-8000-000000000001"
        },
        "item": [
          {
            "linkId": "chief-complaint",
            "text": "請描述這次最主要的不舒服。",
            "answer": [
              {
                "valueString": "胸口中央突然出現壓迫感。"
              }
            ]
          },
          {
            "linkId": "onset",
            "text": "症狀何時開始？",
            "answer": [
              {
                "valueString": "約 30 分鐘前，走路上樓時開始。"
              }
            ]
          },
          {
            "linkId": "quality",
            "text": "疼痛的感覺如何？",
            "answer": [
              {
                "valueString": "像重物壓住，持續沒有完全緩解。"
              }
            ]
          },
          {
            "linkId": "radiation",
            "text": "疼痛是否延伸到其他位置？",
            "answer": [
              {
                "valueString": "會延伸到左肩、左手臂及下顎。"
              }
            ]
          },
          {
            "linkId": "associated-symptoms",
            "text": "是否伴隨其他症狀？",
            "answer": [
              {
                "valueString": "有冒冷汗、噁心和輕微呼吸困難。"
              }
            ]
          },
          {
            "linkId": "negative-findings",
            "text": "是否有撕裂感、近期外傷、發燒或咳嗽？",
            "answer": [
              {
                "valueString": "沒有撕裂感、外傷、發燒或咳嗽。"
              }
            ]
          },
          {
            "linkId": "history",
            "text": "是否有慢性病或相關危險因子？",
            "answer": [
              {
                "valueString": "有高血壓，吸菸約 30 年；否認已知冠心症病史。"
              }
            ]
          },
          {
            "linkId": "allergy",
            "text": "是否有已知藥物過敏？",
            "answer": [
              {
                "valueString": "否認已知藥物過敏。"
              }
            ]
          }
        ]
      },
      "request": {
        "method": "PUT",
        "url": "QuestionnaireResponse/syn-chest-001"
      }
    },
