{
  "name": "medical-consultation-frontend-v2",
  "version": "2.0.0",
  "private": true,
  "type": "module",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev:doctor": "npm run dev --workspace @medical/doctor",
    "dev:patient": "npm run dev --workspace @medical/patient",
    "build": "npm run build:doctor && npm run build:patient",
    "build:doctor": "npm run build --workspace @medical/doctor",
    "build:patient": "npm run build --workspace @medical/patient",
    "test": "node --test tests/*.test.js",
    "test:routes": "node --test tests/route-isolation.test.js"
  },
  "engines": {
    "node": ">=18.0.0"
  },
  "devDependencies": {
    "@vitejs/plugin-vue": "5.2.4",
    "vite": "6.4.3",
    "vue": "3.5.40",
    "vue-router": "4.6.4"
  }
}
