# Optional: override the backend port used by the Vue frontend.
VITE_BACKEND_PORT=18000
# Vite development and production containers use a same-origin proxy path so
# the one-time launch exchange can set an HttpOnly patient session cookie.
VITE_BACKEND_BASE_URL=/api

# Development/test only. Vite dev mode enables this when unset.
# Keep false for production; set true only for an explicit test build.
VITE_ENABLE_DIRECT_FHIR=false
VITE_FHIR_BASE_URL=http://localhost:8080/fhir

# SMART EHR Launch client registration. This identifier is public and must
# match the client registered by the SMART authorization server.
VITE_SMART_CLIENT_ID=my_web_app

# Avatar provider: local (default) or did.
VITE_AVATAR_PROVIDER=local
# WARNING: every VITE_* value is embedded in public browser JavaScript.
# Prefer entering D-ID credentials in the UI. If preconfigured, use only a
# browser/embed key restricted to the deployed origin; never use a server key.
VITE_DID_CLIENT_KEY=
VITE_DID_AGENT_ID=
