# Copy to .env on the Ubuntu host and replace every *.example.invalid value.
COMPOSE_PROJECT_NAME=medical-consultation

# Public patient site. DNS must resolve to the Ubuntu gateway.
PATIENT_SERVER_NAME=patient.example.invalid
PATIENT_PUBLIC_BASE_URL=https://patient.example.invalid
PATIENT_HTTPS_BIND=0.0.0.0
PATIENT_HTTPS_PORT=443

# Bind the UCC gateway to the Ubuntu private/LAN address, never 0.0.0.0.
UCC_API_BIND_IP=10.20.30.40
UCC_API_PORT=8443
# Single host (/32) or a tightly scoped clinical-network CIDR allowed by Nginx.
UCC_SOURCE_CIDR=10.20.30.10/32

UCC_JWT_PUBLIC_KEY_PATH=/run/secrets/ucc-jwt-public.pem
UCC_JWT_ISSUER=ucc-ehis
UCC_JWT_AUDIENCE=medical-consultation-api

CONSULTATION_DB_PATH=/var/lib/medical-consultation/consultations.db
CONSULTATION_TIMEZONE=Asia/Taipei
PATIENT_SESSION_COOKIE=ai_patient_session
PATIENT_COOKIE_SECURE=true
ENABLE_UNVERSIONED_ALIASES=false
# Formal browser applications use same-origin proxies, so leave this empty.
# A host-run development frontend may explicitly allow localhost as documented.
CORS_ALLOWED_ORIGINS=

# Optional development frontend entry. Port 8000 is always bound to host
# loopback only; authentication bypass remains disabled in deployment defaults.
DEVELOPMENT_API_PORT=18000
ALLOW_LOCAL_AUTH_BYPASS=false

INTERVIEW_ENGINE=amie
AMIE_DEBUG_TRACE=false
ASR_PROVIDER=breeze
BREEZE_ASR_DEVICE=cuda
# Return Breeze VRAM before the following chat/avatar request.
# Keep models resident on the verified 16 GB profile; use true on smaller GPUs.
BREEZE_ASR_RELEASE_GPU_AFTER_TRANSCRIBE=false
# ASR_MAX_AUDIO_SECONDS=120
# ASR_MIN_AUDIO_RMS=0.001
LLM_PROVIDER=gemini
GEMINI_API_KEY=replace-me
# GROQ_API_KEY=replace-me
FHIR_BASE_URL=http://host.docker.internal:8080/fhir

# Optional on-host RAG assets. Empty directories are accepted and disable RAG.
RAG_CHROMA_DB_PATH=../backend/chroma_db
SNOMED_DATA_PATH=../backend/terminology/snomed
HF_MODEL_CACHE_PATH=../.rag-cache/huggingface/hub

# Fully local text-to-speech and lip-sync avatar. Model weights download only
# on the first request, then remain in the avatar-models Docker volume.
# Use `local` for CosyVoice3 + MuseTalk or `did` for the retained D-ID client.
AVATAR_PROVIDER=local
# Required only for AVATAR_PROVIDER=did. These are embedded in the patient
# browser bundle at build time; use only credentials intended for client use.
DID_CLIENT_KEY=
DID_AGENT_ID=
AVATAR_ENABLED=true
# Loopback-only port used by a host-run backend; do not bind this to 0.0.0.0.
AVATAR_HOST_PORT=8090
AVATAR_REQUIRE_CUDA=true
AVATAR_STATIC_FALLBACK=true
# Return Avatar VRAM to the lazy-loaded Breeze ASR after every uncached render.
AVATAR_RELEASE_GPU_AFTER_RENDER=false
AVATAR_TIMEOUT_SECONDS=600
AVATAR_OUTPUT_WIDTH=768
MUSETALK_BATCH_SIZE=8
MUSETALK_FACE_BBOX=585,140,915,520
