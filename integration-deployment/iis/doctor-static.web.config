<?xml version="1.0" encoding="utf-8"?>
<configuration>
  <system.webServer>
    <httpProtocol>
      <customHeaders>
        <remove name="Content-Security-Policy" />
        <add name="Content-Security-Policy" value="default-src 'self'; base-uri 'self'; connect-src 'self'; font-src 'self'; frame-ancestors 'self'; img-src 'self' data: blob:; media-src 'self' blob:; object-src 'none'; script-src 'self'; style-src 'self' 'unsafe-inline'" />
        <remove name="Referrer-Policy" />
        <add name="Referrer-Policy" value="same-origin" />
        <remove name="X-Content-Type-Options" />
        <add name="X-Content-Type-Options" value="nosniff" />
        <remove name="Permissions-Policy" />
        <add name="Permissions-Policy" value="camera=(), geolocation=(), microphone=(self)" />
      </customHeaders>
    </httpProtocol>
  </system.webServer>
</configuration>
