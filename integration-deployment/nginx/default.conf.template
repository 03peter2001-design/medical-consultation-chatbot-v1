log_format privacy '$remote_addr [$time_local] "$request_method $uri $server_protocol" '
                   '$status $body_bytes_sent request_id=$request_id';

resolver 127.0.0.11 valid=10s ipv6=off;

upstream medical_backend {
    zone medical_backend 64k;
    server backend:8000 resolve;
    keepalive 16;
}

# Loopback-published development API. Docker Compose binds this listener only
# to host 127.0.0.1, so the development Vue app can use the containerized
# backend without exposing FastAPI or weakening the public TLS listeners.
server {
    listen 8000;
    server_name _;
    client_max_body_size 12m;
    access_log /var/log/nginx/development-access.log privacy;

    location /v1/ {
        proxy_pass http://medical_backend/v1/;
        proxy_http_version 1.1;
        proxy_set_header Host 127.0.0.1:8000;
        proxy_set_header X-Real-IP 127.0.0.1;
        proxy_set_header X-Forwarded-For 127.0.0.1;
        proxy_set_header X-Forwarded-Proto http;
        proxy_set_header X-Request-ID $request_id;
        proxy_connect_timeout 10s;
        proxy_send_timeout ${AVATAR_UPSTREAM_TIMEOUT};
        proxy_read_timeout ${AVATAR_UPSTREAM_TIMEOUT};
        proxy_request_buffering off;
        proxy_buffering off;
    }

    location / {
        return 404;
    }
}

server {
    listen 443 ssl;
    http2 on;
    server_name ${PATIENT_SERVER_NAME};

    ssl_certificate /etc/nginx/tls/fullchain.pem;
    ssl_certificate_key /etc/nginx/tls/private-key.pem;
    ssl_protocols TLSv1.2 TLSv1.3;
    ssl_session_cache shared:patient_tls:10m;
    ssl_session_timeout 1d;
    ssl_session_tickets off;

    root /usr/share/nginx/html;
    index index.html;
    client_max_body_size 12m;

    access_log /var/log/nginx/access.log privacy;
    add_header Strict-Transport-Security "max-age=31536000; includeSubDomains" always;
    add_header X-Content-Type-Options nosniff always;
    add_header Referrer-Policy no-referrer always;
    add_header Permissions-Policy "camera=(), geolocation=(), microphone=(self)" always;
    # Local mode expands the suffix to empty. The deployment script permits
    # only the exact D-ID HTTPS/WSS origins when provider `did` is selected.
    # The D-ID SDK is locally bundled, so script-src always remains self-only.
    add_header Content-Security-Policy "default-src 'self'; base-uri 'self'; connect-src 'self'${AVATAR_CSP_CONNECT_SRC_SUFFIX}; font-src 'self'; form-action 'self'; frame-ancestors 'none'; img-src 'self' data: blob:; media-src 'self' blob:; object-src 'none'; script-src 'self'; style-src 'self' 'unsafe-inline'" always;

    location = /healthz {
        access_log off;
        default_type text/plain;
        return 200 "ok\n";
    }

    location = /avatar/doctor.png {
        access_log off;
        alias /usr/share/nginx/avatar-doctor.png;
    }

    # Do not publish clinician endpoints or invitation creation on the patient
    # hostname even though FastAPI independently enforces bearer scopes.
    location ^~ /api/v1/doctor/ {
        return 404;
    }

    location = /api/v1/invitations {
        return 404;
    }

    # Local TTS + lip-sync generation can take longer than a chat request on
    # its first model load. Authentication is still enforced by FastAPI.
    location = /api/v1/avatar/speak {
        proxy_pass http://medical_backend/v1/avatar/speak;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $remote_addr;
        proxy_set_header X-Forwarded-Proto https;
        proxy_set_header X-Request-ID $request_id;
        proxy_connect_timeout 10s;
        proxy_send_timeout ${AVATAR_UPSTREAM_TIMEOUT};
        proxy_read_timeout ${AVATAR_UPSTREAM_TIMEOUT};
        proxy_buffering off;
    }

    # Backend authentication remains authoritative. The public gateway exposes
    # versioned APIs only; unversioned compatibility aliases stay unreachable.
    location /api/v1/ {
        proxy_pass http://medical_backend/v1/;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $remote_addr;
        proxy_set_header X-Forwarded-Proto https;
        proxy_set_header X-Request-ID $request_id;
        proxy_connect_timeout 10s;
        proxy_send_timeout 180s;
        proxy_read_timeout 180s;
        proxy_request_buffering off;
    }

    location / {
        try_files $uri $uri/ /index.html;
    }
}

# Private UCC-to-backend gateway. Publish port 8443 only on the Ubuntu LAN IP,
# restrict it here and repeat the same restriction in the host firewall.
server {
    listen 8443 ssl;
    http2 on;
    server_name _;

    ssl_certificate /etc/nginx/tls/fullchain.pem;
    ssl_certificate_key /etc/nginx/tls/private-key.pem;
    ssl_protocols TLSv1.2 TLSv1.3;
    client_max_body_size 12m;
    access_log /var/log/nginx/ucc-access.log privacy;

    allow ${UCC_SOURCE_CIDR};
    deny all;

    location /v1/ {
        proxy_pass http://medical_backend/v1/;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $remote_addr;
        proxy_set_header X-Forwarded-Proto https;
        proxy_set_header X-Request-ID $request_id;
        proxy_connect_timeout 10s;
        proxy_send_timeout 180s;
        proxy_read_timeout 180s;
        proxy_request_buffering off;
    }

    location / {
        return 404;
    }
}
