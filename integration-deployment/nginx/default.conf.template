log_format privacy '$remote_addr [$time_local] "$request_method $uri $server_protocol" '
                   '$status $body_bytes_sent request_id=$request_id';

upstream medical_backend {
    server backend:8000;
    keepalive 16;
}

server {
    listen 443 ssl;
    http2 on;
    server_name ${PATIENT_SERVER_NAME};

    ssl_certificate /etc/nginx/tls/fullchain.pem;
    ssl_certificate_key /etc/nginx/tls/private-key.pem;
    ssl_protocols TLSv1.2 TLSv1.3;
    ssl_session_cache shared:patient_tls:10m;
    ssl_session_timeout 1d;
    ssl_session_tickets off;

    root /usr/share/nginx/html;
    index index.html;
    client_max_body_size 12m;

    access_log /var/log/nginx/access.log privacy;
    add_header Strict-Transport-Security "max-age=31536000; includeSubDomains" always;
    add_header X-Content-Type-Options nosniff always;
    add_header Referrer-Policy no-referrer always;
    add_header Permissions-Policy "camera=(), geolocation=(), microphone=(self)" always;
    add_header Content-Security-Policy "default-src 'self'; base-uri 'self'; connect-src 'self'; font-src 'self'; form-action 'self'; frame-ancestors 'none'; img-src 'self' data: blob:; media-src 'self' blob:; object-src 'none'; script-src 'self'; style-src 'self' 'unsafe-inline'" always;

    location = /healthz {
        access_log off;
        default_type text/plain;
        return 200 "ok\n";
    }

    # Do not publish clinician endpoints or invitation creation on the patient
    # hostname even though FastAPI independently enforces bearer scopes.
    location ^~ /api/v1/doctor/ {
        return 404;
    }

    location = /api/v1/invitations {
        return 404;
    }

    # Backend authentication remains authoritative. The public gateway exposes
    # versioned APIs only; unversioned compatibility aliases stay unreachable.
    location /api/v1/ {
        proxy_pass http://medical_backend/v1/;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto https;
        proxy_set_header X-Request-ID $request_id;
        proxy_connect_timeout 10s;
        proxy_send_timeout 180s;
        proxy_read_timeout 180s;
        proxy_request_buffering off;
    }

    location / {
        try_files $uri $uri/ /index.html;
    }
}

# Private UCC-to-backend gateway. Publish port 8443 only on the Ubuntu LAN IP,
# restrict it here and repeat the same restriction in the host firewall.
server {
    listen 8443 ssl;
    http2 on;
    server_name _;

    ssl_certificate /etc/nginx/tls/fullchain.pem;
    ssl_certificate_key /etc/nginx/tls/private-key.pem;
    ssl_protocols TLSv1.2 TLSv1.3;
    client_max_body_size 12m;
    access_log /var/log/nginx/ucc-access.log privacy;

    allow ${UCC_SOURCE_CIDR};
    deny all;

    location /v1/ {
        proxy_pass http://medical_backend/v1/;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto https;
        proxy_set_header X-Request-ID $request_id;
        proxy_connect_timeout 10s;
        proxy_send_timeout 180s;
        proxy_read_timeout 180s;
        proxy_request_buffering off;
    }

    location / {
        return 404;
    }
}
